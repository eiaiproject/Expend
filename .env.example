# Expend Environment Variables
# This file documents available environment variables for development.
# Copy this file to .env and uncomment values as needed.

# GIT_HASH: Git commit hash for version tracking (set in CI)
# GIT_HASH=abc1234

# BUILD_DATE: Optional ISO build date for release metadata.
# Leave unset in local/source-identical builds to avoid time-only bundle changes.
# BUILD_DATE=2026-06-12T00:00:00.000Z

# DISABLE_HMR: Set to "true" to disable Hot Module Replacement in dev server
# DISABLE_HMR=false

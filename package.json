{
  "name": "expend",
  "private": true,
  "version": "1.18.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=critical --package-lock-only",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome'",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium firefox webkit",
    "version": "node scripts/sync-version.mjs",
    "qa:automated": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run i18n:check && npm run test:unit && npm run build && npm run test:e2e:chromium",
    "i18n:check": "node scripts/check-i18n-keys.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.0.8",
    "papaparse": "^5.5.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.17.0",
    "reicon-react": "^1.1.302",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "tailwindcss": "^4.1.14",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}

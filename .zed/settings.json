{
  "context_servers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--headless",
        "--browser",
        "chromium",
        "--viewport-size",
        "1280x720",
        "--isolated",
        "--output-dir",
        "test-results/playwright-mcp"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      }
    }
  }
}
